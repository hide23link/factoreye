# FactorEye の設定ファイル（これ 1 つに集約しています。場所: /opt/factoreye/config/.env）。
#
# - テキストエディタで直接編集できます。変更したら `./factoreye.sh restart` で反映します。
# - 画面の「設定 → API・取り込み」からも変更できます（管理パスワードが必要）。画面で保存すると、
#   このファイルが書き換わり、バックエンドが自動で再起動します。
# - このファイルには秘密の値が入っています。他人に見せない・公開しない・Git に入れないでください。
# - install.sh が、乱数を入れる場所（値が「GENERATE」で始まる行）を埋めて作ります。手で作る場合は、自分で入れてください。

# ---- 取り込み（センサー → FactorEye）-----------------------------------------
# 機器が送るときのキー（X-API-Key ヘッダー）。長い乱数にしておく
INGEST_API_KEY=__GENERATE__
# key: 上のキーが必要 / off: キーなしで受け付ける（取り込みの口を LAN などに限定した運用向け）
INGEST_AUTH=key
# 未登録のセンサー ID が来たら、自動でセンサーを作る（true / false）。打ち間違いの ID でも作られる
INGEST_AUTO_CREATE=false
INGEST_AUTO_CREATE_MAX_SENSORS=100
# 機器が付けた測定時刻を使う（true / false）。機器の時計が NTP で合っているときだけ true
INGEST_DEVICE_TIME=false
# 同じ接続元からの取り込みの上限（例: 100/minute）。off で解除
INGEST_RATE_LIMIT=100/minute
# 取り込みの照合を覚えておく秒数（0 で無効）
INGEST_CACHE_SECONDS=5

# ---- 通知・連携 ------------------------------------------------------------
# Webhook の送信先に、社内ネットワーク（http・プライベート IP）を許可する（true / false）
WEBHOOK_ALLOW_PRIVATE_NETWORKS=false

# ---- 管理パスワード（設定画面の変更に必要）----------------------------------
# ハッシュで保存します。変えるときは `./factoreye.sh set-password`（単一引用符で囲むこと）
ADMIN_PASSWORD_HASH=

# ---- 画面のアドレス ---------------------------------------------------------
# 画面を開く URL。install.sh が、この PC の IP から作ります
FRONTEND_URL=http://localhost:3001
# 公開するポート（変えたら FRONTEND_URL も合わせる）
FACTOREYE_PORT=3001

# ---- ここから下は、通常は変えません ----------------------------------------
ENVIRONMENT=production
JWT_SECRET=__GENERATE__
POSTGRES_PASSWORD=__GENERATE__
# 上の POSTGRES_PASSWORD と同じ値にする
DATABASE_URL=postgresql+asyncpg://factoreye:__GENERATE__@postgres:5432/factoreye
# 使うイメージの版（latest か、v1.0.0 のような版）
FACTOREYE_VERSION=latest
