# docker-compose.yml 用の環境変数（docker compose は同じ階層の .env を自動で読み込む）。
# このファイル自体はコミットしてよい（値はダミー）。実際に使う場合は .env にコピーして編集する
# （.env は .gitignore 済み）。
#
# 何も設定しなければ、これまで通り http://localhost:*（PC単体での動作確認）になる。
# LAN上の別ホスト（Raspberry Pi等）で動かし、他のPC/スマホのブラウザからアクセスする場合のみ、
# 下記をそのホストの実際のIPに書き換える。

# frontendのビルド時に焼き込まれる、backend APIのURL（ブラウザから見えるアドレス）
# VITE_API_URL=http://<このホストのLAN内IPアドレス>:8000

# backendのCORS許可オリジン（↑のVITE_API_URLに対応するfrontendのURL）
# FRONTEND_URL=http://<このホストのLAN内IPアドレス>:3001

# 以下は本番運用時に変更すること（self-hosted共有シークレット）
INGEST_API_KEY=change-this-in-production
JWT_SECRET=change-this-in-production
# 取り込みの認証（既定: key）。off にすると、機器が X-API-Key なしで送れる。
# off のときは、センサーの ingestKey を知っていれば誰でも値を書けるので、取り込みの口を LAN などに限定すること。
# off のときは INGEST_API_KEY を使わない（本番の既定値の検査もしない）
# INGEST_AUTH=key
# 未登録の ingestKey のセンサーを自動で作る（self-hosted だけ。既定 false）。機器の追加のたびに画面で登録しなくてよくなる。
# 打ち間違いの ID でも、センサーができる。作る数の上限は MAX_SENSORS（既定 100）。SaaS では無視する。
# INGEST_AUTO_CREATE=false
# INGEST_AUTO_CREATE_MAX_SENSORS=100
# 機器が付けた測定時刻（timestamp）を使う（self-hosted だけ。既定 false = 受信時刻）。機器の時計が NTP で合っているときだけ on
# INGEST_DEVICE_TIME=false
# 本番として動かす場合だけ production にする（/docs を非公開にする）。
# production では、上の INGEST_API_KEY（AUTH_MODE=multi_tenant なら JWT_SECRET）が
# 既定値のままだと起動しない。値を変えてからコメントを外すこと
# ENVIRONMENT=production

# Webhookの送信先を社内ネットワーク（プライベートIP・http）に許可する（既定: false）。
# false のままだと https かつ公開IPの宛先だけ送信できる（SSRF対策）。
# 社内LANの自動化基盤（n8n等）へ送る自己ホスト利用者だけ true にする。
# WEBHOOK_ALLOW_PRIVATE_NETWORKS=false
