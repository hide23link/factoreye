# 復旧ツールの設定。コピーして .env にする（Git 管理外）

# 画面の Basic 認証（12 文字以上）。生成例: openssl rand -hex 16
RECOVERY_USERNAME=admin
RECOVERY_PASSWORD=CHANGE_ME

# バックアップの読み込み元。既定は BACKUP_DIR を /backups に見せたもの
# BACKUP_DIR=/opt/factoreye/backups
# S3 の場合（AWS_ACCESS_KEY_ID などは下に。鍵は読むだけの権限にする）
# BACKUP_SOURCE=s3://my-bucket/factoreye
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=ap-northeast-1
# S3 互換のサービス（MinIO など）の場合
# S3_ENDPOINT_URL=

# 今の DB（読み取り専用で接続する）。無ければ空のまま（バックアップだけを扱う）
# 本番の LXC: 読み取り専用のロールを作って使う（README.md「読み取り専用のロール」）
# TARGET_DATABASE_URL=postgresql://factoreye_readonly:<パスワード>@postgres:5432/factoreye

# バックアップのファイルのグループ ID（既定 0 = root。ラズパイでは offsite-pull.sh を動かす利用者のグループ）
# BACKUP_GID=1000

# 書き戻し（バックアップ → 今の DB）に使う接続。設定しなければ書き戻しは使えない（閲覧だけ）
# TARGET_WRITE_DATABASE_URL=postgresql://factoreye:<POSTGRES_PASSWORD>@postgres:5432/factoreye
# 今の DB が SaaS 版なら saas、OSS 版なら oss（書き戻しを使うなら必須）
# TARGET_MODE=saas

# 引き継ぎ（控え＝AWS が稼いだ増加分の縮小ダンプ）の読み込み元。管理画面の「書き戻し」が使う。
# 鍵と S3_ENDPOINT_URL（R2）は、BACKUP_SOURCE と同じものを読む。無ければ、引き継ぎからの書き戻しは使えない
# HANDOFF_SOURCE=s3://factoreye-backup/handoff-inc

# 画面の待ち受け（既定 127.0.0.1:8090）
# RECOVERY_BIND=<Tailscale の IP>
# RECOVERY_PORT=8090
