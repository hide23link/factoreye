# WAL-G の設定（R2 へ WAL とベースバックアップを送る）。docker の env_file の形式（シェルではない。値に引用符を付けない）。
# 本番では /opt/factoreye/walg/walg.env に置く（Git 管理外。権限 600、所有者 root）。infra/walg/make-conf.sh が、鍵から作る。
# 設計と、各値の根拠（試験の結果）は ecopower の docs/aws-dr-wal-design.md。
#
# **置き場: 専用のバケット factoreye-db の直下。このバケットは WAL-G 専用にする。**
#   WAL-G の `delete` は、置き場の下にある WAL に見えるファイルを、すべて対象にする。ほかのバックアップと同じ場所に置くと、消してしまう（試験で実際に起きた）。
#   直下に置くので、階層は最大 3 段（basebackups_005/base_<名前>/tar_partitions/<ファイル>。WAL は wal_005/<ファイル>）。
AWS_ACCESS_KEY_ID=<R2 の Access Key ID（バケット factoreye-db だけの Object Read & Write）>
AWS_SECRET_ACCESS_KEY=<R2 の Secret Access Key>
AWS_ENDPOINT=https://<アカウント ID>.r2.cloudflarestorage.com
AWS_S3_FORCE_PATH_STYLE=true
AWS_REGION=auto
WALG_S3_PREFIX=s3://factoreye-db
# 圧縮は zstd。差分（デルタ）は、最大 7 世代まで（全体 → 差分 → 差分 …）
WALG_COMPRESSION_METHOD=zstd
WALG_DELTA_MAX_STEPS=7
WALG_UPLOAD_CONCURRENCY=4
WALG_DOWNLOAD_CONCURRENCY=4
# 本番の PostgreSQL の管理者のロールは factoreye（postgres ではない）
PGUSER=factoreye
PGDATABASE=factoreye
