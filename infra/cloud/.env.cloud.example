# FactorEye Cloud 本番環境変数テンプレート
# このファイルをコピーして /opt/factoreye/.env として保存し、値を全て設定すること。
# .env は絶対にリポジトリにコミットしない（.gitignore 済み）。

# 公開ドメイン（Cloudflare Tunnel のドメイン、CORS 許可オリジンに使われる）
DOMAIN=factoreye.hide23.link

# PostgreSQL パスワード（必ず変更すること）
# 生成例: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# Ingest API キー（センサーがデータ送信に使用する。変更後はセンサー側も合わせる）
# 生成例: openssl rand -hex 32
INGEST_API_KEY=CHANGE_ME_STRONG_RANDOM_KEY

# JWT 署名シークレット（32 文字以上のランダム文字列）
# 生成例: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET
