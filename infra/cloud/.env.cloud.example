# FactorEye Cloud 本番環境変数テンプレート
# このファイルをコピーして /opt/factoreye/.env として保存し、値を全て設定すること。
# .env は絶対にリポジトリにコミットしない（.gitignore 済み）。

# 公開ドメイン（Cloudflare Tunnel のドメイン、CORS 許可オリジンに使われる）
DOMAIN=factoreye.example.com

# PostgreSQL パスワード（必ず変更すること）
# 生成例: openssl rand -hex 24
POSTGRES_PASSWORD=CHANGE_ME_STRONG_RANDOM_PASSWORD

# Ingest API キー（センサーがデータ送信に使用する。変更後はセンサー側も合わせる）
# 生成例: openssl rand -hex 32
INGEST_API_KEY=CHANGE_ME_STRONG_RANDOM_KEY

# JWT 署名シークレット（32 文字以上のランダム文字列）
# 生成例: openssl rand -hex 32
JWT_SECRET=CHANGE_ME_STRONG_RANDOM_SECRET

# 登録・ログインのメール（Resend）。factoreye 専用のキー（送信のみ・ドメイン限定）を Resend で作って設定する。
# 空のままなら、メールを送る API は 503（登録・ログインリンク・管理者のリセットが使えない）
# RESEND_API_KEY=<Resend の API キー>
# MAIL_FROM=FactorEye <noreply@hide23.link>
# メールの 1 日（UTC。日本時間の 9:00 に切り替わる）の送信数の上限。Resend の無料枠（1 日 100 通）に収める。0 以下は上限なし
# EMAIL_DAILY_LIMIT=60
# 上限のこの割合（%）に達したとき、運用者用の Discord に 1 日 1 回知らせる（上限に達したときも別に 1 回）
# EMAIL_DAILY_WARN_PERCENT=80
# 運用者用の Discord Webhook の URL（メール送信数の通知先）。空なら通知しない
# OPS_DISCORD_WEBHOOK_URL=<Discord の Webhook URL>

# 管理画面の「書き戻し」（控え＝AWS が稼いだデータを本番に足す）が呼ぶ、復旧ツールの認証。
# 復旧ツール（tools/recovery/.env）の RECOVERY_USERNAME / RECOVERY_PASSWORD と同じ値にする。
# 空のままなら、書き戻しは使えない。生成例: openssl rand -hex 16
# FAILBACK_RECOVERY_URL=http://recovery:8090
# FAILBACK_RECOVERY_USERNAME=admin
# FAILBACK_RECOVERY_PASSWORD=
