DATABASE_URL=postgresql+asyncpg://factoreye:password@localhost:5432/factoreye
INGEST_API_KEY=change-this-in-production
JWT_SECRET=change-this-in-production
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3001
# SaaS（AUTH_MODE=multi_tenant）のメール（Resend）。空なら、登録・ログインのメールを送れない
# RESEND_API_KEY=<Resend の API キー>
# MAIL_FROM=FactorEye <noreply@hide23.link>
# メールの 1 日（UTC）の送信数の上限（既定 60。0 以下は上限なし）と、運用者へ知らせる割合（%）
# EMAIL_DAILY_LIMIT=60
# EMAIL_DAILY_WARN_PERCENT=80
# 運用者用の Discord Webhook の URL（メール送信数の通知先）。空なら通知しない
# OPS_DISCORD_WEBHOOK_URL=<Discord の Webhook URL>
